{
  "name": "photography-react",
  "licence": "GPL-3.0-only",
  "lockfileVersion": 2,
  "version": "0.2.0",
  "private": true,
  "requires": true,
  "type": "module",
  "engine": {
    "node": "18"
  },
  "scripts": {
    "start": "vite --open --host",
    "build:preview": "vite preview --open --host",
    "build": "tsc && vite build",
    "firebase:deploy": "firebase deploy",
    "lint": "eslint src/**/*.{js,jsx,ts,tsx,json}",
    "lint:fix": "eslint --fix src/**/*.{js,jsx,ts,tsx,json}",
    "prettier": "prettier --write src/**/*.{js,jsx,ts,tsx,css,md,json,scss} --config ./.prettierrc",
    "play:script": "ts-node --esm ./src/scripts/script.exif.ts"
  },
  "dependencies": {
    "@types/node": "^24.0.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "exifr": "7.1.3",
    "image-size": "^2.0.2",
    "photoswipe": "^5.4.4",
    "photoswipe-dynamic-caption-plugin": "^1.2.7",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-photoswipe-gallery": "^3.1.1",
    "sass": "^1.89.2",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "7.37.5",
    "fraction.js": "5.2.2",
    "prettier": "^3.7.4",
    "tsconfig-paths": "^4.2.0",
    "vite": "7.1.11",
    "vite-plugin-pwa": "1.2.0",
    "workbox-background-sync": "^7.4.0",
    "workbox-broadcast-update": "^7.4.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-navigation-preload": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-range-requests": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-streams": "^7.4.0"
  }
}
